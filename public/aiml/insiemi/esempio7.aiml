        <template><think><set name="dialogue_act">setQuestion</set></think><think><set name="elemento1">27</set></think><think><set name="elemento2">none</set></think><think><set name="insieme">B</set></think><think><set name="topic">funzione_inversa</set></think>Luca e Davide sono collegati a 27.<image>insiemi/esempio7.svg</image><svgElement style-name="stroke" style-value="#04ed00">link-Luca-27</svgElement><svgElement style-name="stroke" style-value="#04ed00">link-Davide-27</svgElement></template>
    </category>
    <category>
