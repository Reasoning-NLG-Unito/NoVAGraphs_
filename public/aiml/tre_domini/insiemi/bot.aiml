    <!-- ================================== -->
    <!-- ============ GENERICA ============ -->
    <!-- ================================== -->
    <!-- nlg -->
    <category>
        <pattern>TA ANSWER GENERICO</pattern>
        <template>
            <condition name="qud">
                <li value="null">
                    Puoi specificare meglio cosa non ti è chiaro?
                </li>
                <li>
                    <srai><get name="qud"/></srai>
                </li>
            </condition>
        </template>
    </category>

