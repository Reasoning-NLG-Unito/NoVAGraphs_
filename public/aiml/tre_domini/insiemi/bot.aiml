    <category>
        <pattern>CIAO *</pattern>
        <template>
            <think><set name="qud">null</set></think>

            <think><set name="shared_teoria_funzioni">no</set></think>
            <think><set name="shared_teoria_dominio">no</set></think>
            <think><set name="shared_teoria_codominio">no</set></think>
            <think><set name="shared_teoria_suriettiva">no</set></think>
            <think><set name="shared_teoria_iniettiva">no</set></think>
            <think><set name="shared_teoria_biunivoca">no</set></think>
            <think><set name="shared_teoria_funzioni_numeriche">no</set></think>
            <think><set name="shared_teoria_insieme">no</set></think>
            <think><set name="shared_teoria_freccia">no</set></think>

            <think><set name="shared_teoria_funzioni_inverse">no</set></think>
            <think><set name="shared_teoria_composizione">no</set></think>
            <think><set name="shared_teoria_relazione">no</set></think>
            <think><set name="shared_teoria_proprieta_riflessiva">no</set></think>
            <think><set name="shared_teoria_proprieta_simmetrica">no</set></think>
            <think><set name="shared_teoria_proprieta_transitiva">no</set></think>
            <think><set name="shared_teoria_proprieta_antiriflessiva">no</set></think>
            <think><set name="shared_teoria_proprieta_asimmetrica">no</set></think>
            <think><set name="shared_teoria_relazione_equivalenza">no</set></think>
            <think><set name="shared_teoria_classe_equivalenza">no</set></think>
            <think><set name="shared_teoria_insieme_quoziente">no</set></think>
            <think><set name="shared_teoria_relazione_ordine_largo">no</set></think>
            <think><set name="shared_teoria_relazione_ordine_stretto">no</set></think>
            <think><set name="shared_teoria_relazione_ordine_totale">no</set></think>
            <think><set name="shared_teoria_relazione_ordine_parziale">no</set></think>


            <think><set name="shared_motivazione_img">no</set></think>
            <think><set name="shared_stesso_elemento">no</set></think>

            <think><set name="shared_esercizio_generico">no</set></think>

            Ciao, sono NoVABot. 
            Sono programmato per rispondere a domande riguardanti gli insiemi matematici. 
            Come posso aiutarti?
        </template>
    </category>
    
    <category>
        <pattern>BUONGIORNO *</pattern>
        <template>
            <srai>CIAO</srai>
        </template>
    </category>
    
