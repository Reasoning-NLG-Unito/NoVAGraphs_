        <template><think><set name="dialogue_act">setQuestion</set></think><think><set name="elemento1">Paola</set></think><think><set name="elemento2">none</set></think><think><set name="insieme">A</set></think><think><set name="topic">funzione</set></think>L'elemento Paola dell'insieme A è collegato all'elemento 27 dell'insieme B.<image>insiemi/esempio3.svg</image><svgElement style-name="stroke" style-value="#04ed00">link-Paola-27</svgElement></template>
    </category>
    <category>
        <pattern>* LEONE *</pattern>
        <template><think><set name="dialogue_act">setQuestion</set></think><think><set name="elemento1">Leone</set></think><think><set name="elemento2">none</set></think><think><set name="insieme">A</set></think><think><set name="topic">funzione</set></think>L'elemento Leone dell'insieme A è collegato all'elemento 42 dell'insieme B.<image>insiemi/esempio3.svg</image><svgElement style-name="stroke" style-value="#04ed00">link-Leone-42</svgElement></template>
    </category>
    <category>
        <pattern>* 27 *</pattern>
        <template><think><set name="dialogue_act">setQuestion</set></think><think><set name="elemento1">27</set></think><think><set name="elemento2">none</set></think><think><set name="insieme">B</set></think><think><set name="topic">funzione_inversa</set></think>Paola è collegato a 27.<image>insiemi/esempio3.svg</image><svgElement style-name="stroke" style-value="#04ed00">link-Paola-27</svgElement></template>
    </category>
    <category>
        <pattern>* 34 *</pattern>
