    <category>
        <pattern>* 30 *</pattern>
        <template><think><set name="dialogue_act">setQuestion</set></think><think><set name="elemento1">30</set></think><think><set name="elemento2">none</set></think><think><set name="insieme">B</set></think><think><set name="topic">funzione_inversa</set></think>Cesare è collegato a 30.<image>insiemi/esempio3.svg</image><svgElement style-name="stroke" style-value="#04ed00">link-Cesare-30</svgElement></template>
