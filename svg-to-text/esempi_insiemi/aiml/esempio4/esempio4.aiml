    <category>
        <pattern>* PARLAMI * DOMINIO *</pattern>
        <template><think><set name="dialogue_act">A</set></think><think><set name="elemento1">A</set></think><think><set name="elemento2">A</set></think><think><set name="insieme">A</set></think><think><set name="topic">A</set></think>L'insieme A è composto da 4 elementi: Margherita, Carlotta, Massimo, Noemi.<image>insiemi/esempio4.svg</image><svgElement style-name="fill" style-value="#04ed00">insieme-dominio</svgElement></template>
    </category>
    <category>
